# API URL (backend).
# Dev: http://localhost:8001
# Production (set this in the Vercel project's Environment Variables, not here — Vite bakes it
# in at build time, so changing it on Vercel requires a redeploy): your Railway backend's public
# HTTPS URL, e.g. https://bonus-life-ai-backend.up.railway.app (or your custom API domain).
# Must include the scheme, no trailing slash.
VITE_API_URL=http://localhost:8001

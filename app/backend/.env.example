# Copy to .env and fill in your values.
# === Groq LLM ===
GROQ_API_KEY=
# llama-3.1-8b-instant is no longer served on Groq for most accounts (calls 404).
# Verify what your key can actually access with: GET https://api.groq.com/openai/v1/models
LLM_MODEL_NAME=openai/gpt-oss-20b
LLM_TEMPERATURE=0.6

# === Google Gemini (optional – use instead of Groq when set; use a flash model, not *-pro, to avoid the free tier's strict daily quota) ===
GEMINI_API_KEY=
# gemini-2.5-flash is deprecated for new users on some Google Cloud projects (still
# works on others) — gemini-3.6-flash is the current replacement, verified live.
GEMINI_MODEL=gemini-3.6-flash

# === ElevenLabs (voice agent TTS – required for voice replies) ===
# Get API key from https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=
# Optional: voice ID (default in code: tnSpp4vdxKPjI9w0GnoV). Get from Studio > Voices.
# ELEVENLABS_VOICE_ID=tnSpp4vdxKPjI9w0GnoV
# Optional: model (default: eleven_v3). Or eleven_multilingual_v2.
# ELEVENLABS_MODEL_ID=eleven_v3

# === Server ===
HOST=0.0.0.0
PORT=8001
RELOAD=True
FRONTEND_URL=http://localhost:5173

# Production (set these in the Railway service's Variables tab, not here):
#   RELOAD=False
#   FRONTEND_URL=https://bonus-life-ai-cyan.vercel.app
# Comma-separate multiple origins if you also keep a custom domain live, e.g.
#   FRONTEND_URL=https://bonus-life-ai-cyan.vercel.app,https://bonuslife.tech
# Vercel preview-deployment subdomains (bonus-life-ai-<hash>.vercel.app) are already
# allowed automatically by main.py's CORS regex — no need to list those here.

# === WebAuthn (Passkey login) ===
# Must match the frontend origin exactly, or passkey register/login will fail in the browser.
# Dev: WEBAUTHN_RP_ID=localhost, WEBAUTHN_ORIGIN=http://localhost:5173
# Production (set on Railway): WEBAUTHN_RP_ID=bonus-life-ai-cyan.vercel.app (bare domain, no scheme),
#   WEBAUTHN_ORIGIN=https://bonus-life-ai-cyan.vercel.app (full origin, with scheme)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# === JWT ===
JWT_SECRET=change-this-to-a-long-random-string

# === Database (leave blank to use SQLite on the /app/data volume) ===
DATABASE_URL=

# === Stripe (subscription demo) ===
# Secret key (sk_test_...) from Stripe Dashboard. NOT rk_test_ (restricted).
# Create a Product, add recurring Prices, then paste the Price IDs (price_...).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=price_1T4SO13GwPJnmgaRYJmYHV2w
STRIPE_PRICE_ID_PRO_YEARLY=price_1T4SVw3GwPJnmgaRR2hHvU2d
STRIPE_WEBHOOK_SECRET=
